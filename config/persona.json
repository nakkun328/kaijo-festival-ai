{
  "name": "リク",
  "pronoun": "俺",
  "user_nickname": "あなた（必要なときだけ呼びかける）",
  "mood": "親しみやすく、落ち着いて好奇心がある",
  "mode": "daily",
  "current_interest": "ユーザーが今取り組んでいること",
  "relationship_depth": 1,
  "model": "claude-sonnet-4-6",
  "max_tokens": 700,
  "temperature": 0.8,
  "summary_interval": 8,
  "recent_message_limit": 16,
  "memory_recall_limit": 5,
  "default_provider": "ollama",
  "providers": {
    "ollama": {
      "label": "ローカルAI (Ollama)",
      "model": "gemma4:12b",
      "base_url": "http://127.0.0.1:11434",
      "keep_alive": "24h"
    },
    "openai": {
      "label": "OpenAI API",
      "model": "gpt-5.6-luna"
    },
    "gemini": {
      "label": "Gemini API",
      "model": "gemini-2.5-flash"
    },
    "anthropic": {
      "label": "Anthropic API",
      "model": "claude-sonnet-4-6"
    }
  },
  "voicevox": {
    "engine": "voicevox",
    "base_url": "http://127.0.0.1:50021",
    "engine_path": "tools/voicevox-engine/windows-cpu/run.exe",
    "speaker_label": "玄野武宏 / ノーマル",
    "speaker_id": 11,
    "speed_scale": 1.0,
    "intonation_scale": 1.0,
    "pitch_scale": 0.0
  },
  "whisper": {
    "model": "small",
    "device": "cuda",
    "compute_type": "float16",
    "language": "ja",
    "model_dir": "data/whisper-models",
    "initial_prompt": "日常の雑談、相談、アイデアの壁打ち、天気について話す自然な日本語の会話です。",
    "hotwords": [
      "リク", "アイデア", "壁打ち", "天気"
    ],
    "vad_threshold": 0.35,
    "min_speech_duration_ms": 120,
    "min_silence_duration_ms": 300,
    "speech_pad_ms": 160
  },
  "smart_turn": {
    "model_dir": "data/smart-turn",
    "threshold": 0.5
  },
  "exhibition": {
    "title": "リク・日常会話AI",
    "knowledge_path": "data/festival/knowledge.json",
    "additional_knowledge_paths": [
      "data/festival/website_knowledge.json"
    ],
    "session_message_limit": 20,
    "suggestions": [
      "ちょっと話そう",
      "考えていることを整理したい",
      "アイデアの壁打ちをしよう"
    ]
  }
}
